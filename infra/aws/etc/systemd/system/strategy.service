[Unit]
Description=marker_mission_c2 strategy runner + operator UI on :8091
After=network-online.target marker-mission.service marker-mission-c2.service
# Soft deps: the strategy still boots if the FC is down — its world
# model just reports the FC offline. STOP_MISSION safety overrides
# fire correctly in that state, so this matches the design intent.
Wants=marker-mission.service marker-mission-c2.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/sdc-tobe
# .venv-c2 is the dedicated C2 venv (flask + httpx + requests).
# --config picks the canonical C2 config (same FC list the main
# dashboard uses); --strategy-settings is omitted so the strategy
# resolves marker_mission_c2/strategy/settings.json → settings.example.json
# → defaults, exactly the documented order.
ExecStart=/opt/sdc-tobe/.venv-c2/bin/python -m marker_mission_c2.strategy.app \
          --config /opt/sdc-tobe/marker_mission_c2/config.json
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
