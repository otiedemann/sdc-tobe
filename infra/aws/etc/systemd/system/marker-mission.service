[Unit]
Description=Marker mission UI + planner (sdc-tobe main branch)
After=network.target sphinx-control.service
Wants=sphinx-control.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
# marker_mission lives in the main repo since PR #18 merged. It has
# its own venv (.venv-marker) separate from the FC's .venv so its
# matplotlib + jinja stack doesn't pollute the Olympe environment.
WorkingDirectory=/opt/sdc-tobe
ExecStart=/opt/sdc-tobe/.venv-marker/bin/python3 -m marker_mission.mission --ui-port 9090 --api-url http://127.0.0.1:8080
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
