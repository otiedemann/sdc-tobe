# systemd unit for tools/boxes.py — the box marker display + control panel.
#
# Installed as a *user* unit (no root required), e.g. on flightctrl1:
#   mkdir -p ~/.config/systemd/user
#   cp ~/sdc-tobe/tools/systemd/boxes.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#
# NOT enabled / NOT started automatically — start it on demand with:
#   systemctl --user start boxes
#   systemctl --user status boxes
# To survive logout / start at boot, enable lingering once:
#   sudo loginctl enable-linger sdc   &&   systemctl --user enable boxes
#
# Serves on http://<host>:4000/control and http://<host>:4000/?id=1
[Unit]
Description=Box marker display + control panel (tools/boxes.py)
Documentation=file:/home/sdc/sdc-tobe/tools/boxes.py
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/sdc/sdc-tobe
Environment=HOME=/home/sdc
# Use the repo venv — it has flask + cv2 (system python3 does not).
ExecStart=/home/sdc/sdc-tobe/.venv/bin/python3 -u /home/sdc/sdc-tobe/tools/boxes.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
